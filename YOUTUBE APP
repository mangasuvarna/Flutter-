// --- Data Model for Videos and Shorts (to better manage content) ---
class Content {
  final String title;
  final String channel;
  final String views;
  final String time;
  final String thumbnailUrl;
  final String avatarUrl;
  final String duration;
  final ContentType type;

  const Content({
    required this.title,
    required this.channel,
    required this.views,
    required this.time,
    required this.thumbnailUrl,
    required this.avatarUrl,
    required this.duration,
    this.type = ContentType.video,
  });
}

enum ContentType { video, short }

void main() {
  runApp(const YoutubeCloneApp());
}

