// --- 6. Individual Video Card Widget ---
class VideoCard extends StatelessWidget {
  final Content content;
  const VideoCard({super.key, required this.content});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: <Widget>[
        GestureDetector(
          onTap: () {
            // ignore: avoid_print
            print('Playing video: ${content.title}');
          },
          child: Stack(
            children: <Widget>[
              // 1. Thumbnail Image (Background Layer)
              AspectRatio(
                aspectRatio: 16 / 9,
                child: Image.network(
                  content.thumbnailUrl,
                  fit: BoxFit.cover,
                  loadingBuilder: (BuildContext context, Widget child,
                      ImageChunkEvent? loadingProgress) {
                    if (loadingProgress == null) return child;
                    return Container(color: Colors.grey[300]);
                  },
                  errorBuilder: (BuildContext context, Object error,
                          StackTrace? stackTrace) =>
                      Container(
                          color: Colors.grey[400],
                          child: const Center(
                              child: Icon(Icons.broken_image,
                                  color: Colors.white))),
                ),
              ),

              // 2. Duration Overlay (Foreground Layer, Positioned)
              Positioned(
                bottom: 8,
                right: 8,
                child: Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                  decoration: BoxDecoration(
                    color: const Color.fromARGB(204, 0, 0, 0),
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: Text(
                    content.duration,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
            ],
          ),
        ),

        // Details Row (Avatar, Title, Info, Options)
        Padding(
          padding: const EdgeInsets.all(12.0),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: <Widget>[
              // Channel Avatar
              CircleAvatar(
                radius: 18,
                backgroundImage: content.avatarUrl.isNotEmpty
                    ? NetworkImage(content.avatarUrl)
                    : null,
                onBackgroundImageError: content.avatarUrl.isNotEmpty
                    ? (Object exception, StackTrace? stackTrace) {
                        // ignore: avoid_print
                        print('Error loading avatar: $exception');
                      }
                    : null,
                backgroundColor: Colors.grey[300], // Fallback background
                child: content.avatarUrl.isEmpty
                    ? Text(
                        content.channel.isNotEmpty ? content.channel[0] : '?',
                        style:
                            const TextStyle(color: Colors.black, fontSize: 14))
                    : null,
              ),
              const SizedBox(width: 8),

              // Title and Info Column
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: <Widget>[
                    Text(
                      content.title,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: const TextStyle(
                          color: Colors.black, fontWeight: FontWeight.bold),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      '${content.channel} • ${content.views} • ${content.time}',
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: TextStyle(color: Colors.grey[700], fontSize: 13),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 8),

              // Options Icon
              const Icon(Icons.more_vert, color: Colors.black),
            ],
          ),
        ),
      ],
    );
  }
}

