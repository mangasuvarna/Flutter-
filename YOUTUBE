// --- 2. Main Structure and Navigation ---
class MainScaffold extends StatefulWidget {
  const MainScaffold({super.key});

  @override
  State<MainScaffold> createState() => _MainScaffoldState();
}

class _MainScaffoldState extends State<MainScaffold> {
  int _selectedIndex = 0; // Represents the index in _screens

  final List<Widget> _screens = <Widget>[
    const HomeScreen(),
    const ShortsScreen(),
    const SubscriptionsScreen(),
    const YouScreen(),
  ];

  void _onItemTapped(int index) {
    if (index == 2) {
      // Logic for the center '+' (Create) button
      showModalBottomSheet<void>(
        context: context,
        builder: (BuildContext context) => const Column(
          mainAxisSize: MainAxisSize.min,
          children: <Widget>[
            ListTile(
                leading: Icon(Icons.video_call), title: Text('Upload a video')),
            ListTile(
                leading: Icon(Icons.short_text), title: Text('Create a Short')),
            ListTile(leading: Icon(Icons.live_tv), title: Text('Go live')),
          ],
        ),
      );
    } else {
      setState(() {
        // Map BottomNavigationBar index to _screens index
        if (index < 2) {
          _selectedIndex = index; // 0 -> 0 (Home), 1 -> 1 (Shorts)
        } else {
          // 3 (Subscriptions) -> 2, 4 (You) -> 3
          _selectedIndex = index - 1;
        }
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    // Map _selectedIndex (for _screens) back to BottomNavigationBar index
    int bottomNavCurrentIndex;
    if (_selectedIndex == 0) {
      bottomNavCurrentIndex = 0; // Home
    } else if (_selectedIndex == 1) {
      bottomNavCurrentIndex = 1; // Shorts
    } else if (_selectedIndex == 2) {
      bottomNavCurrentIndex = 3; // Subscriptions
    } else {
      bottomNavCurrentIndex = 4; // You
    }

    return Scaffold(
      body: IndexedStack(
        index: _selectedIndex,
        children: _screens,
      ),
      bottomNavigationBar: BottomNavigationBar(
        type: BottomNavigationBarType.fixed,
        currentIndex: bottomNavCurrentIndex,
        onTap: _onItemTapped,
        selectedItemColor: Colors.black,
        unselectedItemColor: Colors.grey[700],
        backgroundColor: Colors.white,
        elevation: 5,
        items: const <BottomNavigationBarItem>[
          BottomNavigationBarItem(
              icon: Icon(Icons.home_outlined),
              activeIcon: Icon(Icons.home),
              label: 'Home'),
          BottomNavigationBarItem(
              icon: Icon(Icons.video_library_outlined),
              activeIcon: Icon(Icons.video_library),
              label: 'Shorts'),
          BottomNavigationBarItem(
              icon: Icon(Icons.add_circle_outline, size: 36),
              activeIcon: Icon(Icons.add_circle, size: 36),
              label: ''), // This is the central '+' button
          BottomNavigationBarItem(
              icon: Icon(Icons.subscriptions_outlined),
              activeIcon: Icon(Icons.subscriptions),
              label: 'Subscriptions'),
          BottomNavigationBarItem(
              icon: Icon(Icons.person_outline),
              activeIcon: Icon(Icons.person),
              label: 'You'),
        ],
      ),
    );
  }
}

