// --- Custom Widget for Filter Chips Row ---
class FilterChipsRow extends StatelessWidget {
  final List<String> filters;
  final String selectedFilter;
  final ValueChanged<String> onFilterSelected;

  const FilterChipsRow({
    super.key,
    required this.filters,
    required this.selectedFilter,
    required this.onFilterSelected,
  });

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      padding: const EdgeInsets.symmetric(horizontal: 0, vertical: 8.0),
      child: Row(
        children: filters.map<Widget>((String chip) {
          final bool isSelected = chip == selectedFilter;
          return Padding(
            padding: const EdgeInsets.only(right: 8.0),
            child: ChoiceChip(
              label: Text(chip),
              selected: isSelected,
              onSelected: (bool selected) {
                // Only change filter if selected, otherwise keep current selected or default to 'All' if unselecting
                onFilterSelected(selected ? chip : 'All');
              },
              selectedColor: Colors.black,
              backgroundColor: Colors.grey[200],
              labelStyle: TextStyle(
                color: isSelected ? Colors.white : Colors.black,
                fontSize: 14,
              ),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(8),
                side: BorderSide(
                    color: isSelected
                        ? Colors.black
                        : (Colors.grey[300] ?? Colors.grey),
                    width: 1),
              ),
              padding: const EdgeInsets.symmetric(horizontal: 4.0),
            ),
          );
        }).toList(),
      ),
    );
  }
}

