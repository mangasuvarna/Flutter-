  List<Content> _getFilteredVideos() {
    if (_selectedFilter == 'All') {
      return _videos;
    }

    final String lowerCaseFilter = _selectedFilter.toLowerCase();
    final List<Content> matchedVideos = <Content>[];

    // First pass: broad keyword matching
    for (final Content content in _videos) {
      if (content.title.toLowerCase().contains(lowerCaseFilter) ||
          content.channel.toLowerCase().contains(lowerCaseFilter)) {
        matchedVideos.add(content);
      }
    }

    // Second pass: specific filter enhancements/overrides if initial matches are few or irrelevant
    // Using a Set to avoid duplicates if specific additions overlap with general matches
    final Set<Content> uniqueVideos = matchedVideos.toSet();

    if (lowerCaseFilter.contains('music')) {
      uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('music') ||
          content.title.toLowerCase().contains('song') ||
          content.title.toLowerCase().contains('audio') ||
          content.channel.toLowerCase().contains('music') ||
          content.channel.toLowerCase().contains('aditya') ||
          content.channel.toLowerCase().contains('lounge')));
    } else if (lowerCaseFilter.contains('podcast')) {
      uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('podcast') ||
          content.channel.toLowerCase().contains('raw talks') ||
          content.channel.toLowerCase().contains('vamshi kurapati')));
    } else if (lowerCaseFilter.contains('telugu cinema')) {
      uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('telugu') ||
          content.title.toLowerCase().contains('cinema') ||
          content.title.toLowerCase().contains('trailer') ||
          content.title.toLowerCase().contains('cheliya') ||
          content.channel.toLowerCase().contains('telugu') ||
          content.channel.toLowerCase().contains('movie trailers')));
    } else if (lowerCaseFilter.contains('indian culture')) {
      uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('kumbamela') ||
          content.title.toLowerCase().contains('indian culture') ||
          content.channel.toLowerCase().contains('mahakatha')));
    } else if (lowerCaseFilter.contains('news')) {
      uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('news') ||
          content.channel.toLowerCase().contains('tv9')));
    } else if (lowerCaseFilter.contains('bigg boss')) {
       uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('bigg boss') ||
          content.channel.toLowerCase().contains('reality tv hub')));
    } else if (lowerCaseFilter.contains('rashmika mandanna')) {
       uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('rashmika mandanna') ||
          content.channel.toLowerCase().contains('bollywood now')));
    } else if (lowerCaseFilter.contains('flutter app')) {
       uniqueVideos.addAll(_videos.where((content) =>
          content.title.toLowerCase().contains('flutter app') ||
          content.channel.toLowerCase().contains('flutter dev')));
    }

    final List<Content> finalFilteredList = uniqueVideos.toList();

    // Limit to a small number (e.g., 3-5) for specific filters if many matches
    if (finalFilteredList.length > 5) {
      return finalFilteredList.sublist(0, 5);
    }

    // Fallback: If no relevant videos are found for a specific filter, show a few generic ones.
    if (finalFilteredList.isEmpty) {
      return <Content>[
        const Content(
          title: 'How to fill with placeholder | Adobe Design...',
          channel: 'The Wordy Tales',
          views: '387K views',
          time: '6 months ago',
          thumbnailUrl:'https://i.ytimg.com/vi/BlgUZlwrrZM/maxresdefault.jpg' ,
